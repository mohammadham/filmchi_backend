APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=7200

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Media relay: Telegram Drive (primary storage) + 9drive (cache tier)
# ---------------------------------------------------------------------------
# Public links are served on this site's own domain; no file is ever written
# to this server (uploads and downloads are streamed through).
RELAY_ENABLED=true

# Upload destination preflight: seconds a ready / failed answer is cached.
# Ingestion probes the storage chat before it downloads the first byte.
RELAY_DESTINATION_TTL=60
RELAY_DESTINATION_NEGATIVE_TTL=30

# Telegram Drive service (FastAPI "TelegramDrive")
TGDRIVE_BASE_URL=
TGDRIVE_USERNAME=admin
TGDRIVE_PASSWORD=
TGDRIVE_API_KEY=
TGDRIVE_STORAGE_CHAT=
TGDRIVE_DEFAULT_BACKEND=telegram

# 9drive (Google Drive gateway) — the API key needs the files:upload scope
NINEDRIVE_BASE_URL=
NINEDRIVE_API_KEY=
NINEDRIVE_EMAIL=
NINEDRIVE_PASSWORD=
NINEDRIVE_FOLDER_ID=
NINEDRIVE_FRONTEND_URL=
NINEDRIVE_SERVE_MODE=auto

# Relay link behaviour
RELAY_LINK_TTL=0
RELAY_PROXY_STREAM=true
RELAY_CHUNK_SIZE=262144
# Seconds a download may go without a byte before the job gives up (per read).
RELAY_INGEST_STALL_TIMEOUT=300

# Fixed-size ranged chunk for the dynamic ingest queue (MB).
# 8MB keeps each request tiny; a fast worker picks up many chunks,
# a slow/retrying worker only repeats a few MB instead of hundreds.
RELAY_INGEST_CHUNK_MB=8
RELAY_INGEST_CHUNK_STALL_TIMEOUT=60
RELAY_INGEST_CONNECTIONS=24
# Files one ingest worker may process at once (sockets ≈ connections × this).
RELAY_INGEST_CONCURRENCY=1
# Shared socket ceiling for all ingest files; 0 = connections × concurrency.
RELAY_INGEST_TOTAL_CONNECTIONS=0
RELAY_WORKER_STREAMS=2
# Tiny page used to health-test Workers; keep it small so a slow Worker is
# not marked dead before it can finish the probe.
RELAY_WORKER_TEST_URL=https://farsanime.ir/robots.txt

# Disk guard for ingest. Telegram Drive refuses uploads below 15% free, so the
# floor must stay above that or a full disk cannot recover: no upload, no part
# deleted, disk still full. 0 drops the floor; 0 for the ceiling means no cap.
RELAY_INGEST_MIN_FREE_MB=8192
RELAY_INGEST_MAX_INFLIGHT_MB=4096

# Demand tracking / promotion policy
# Set CACHE_DRIVER=redis (or RELAY_STATE_STORE=redis) to keep counters in Redis.
RELAY_STATE_STORE=
RELAY_PROMOTE_THRESHOLD=3
RELAY_DEMAND_WINDOW=86400
RELAY_CACHE_TTL=0
RELAY_AUTO_PROMOTE=true
# Cache tier budget in MB; 0 = unlimited. Past it, relay:evict demotes the
# least recently used warm files, but never one idle under this many seconds.
RELAY_MAX_CACHE_MB=0
RELAY_EVICT_MIN_IDLE=3600
RELAY_QUEUE_NAME=default
RELAY_INGEST_RETRY_MAX_ATTEMPTS=3
RELAY_INGEST_RETRY_DELAY_SECONDS=300
# Quarantine of dead links: zero-byte attempts / distinct Workers before dead.
RELAY_QUARANTINE_ZERO_ATTEMPTS=2
RELAY_QUARANTINE_ZERO_WORKERS=2
# Attempt-history rows kept per source; counters reset, history does not.
RELAY_INGEST_HISTORY_LIMIT=100
RELAY_UPLOAD_RETRY_MAX_ATTEMPTS=3
RELAY_UPLOAD_RETRY_DELAY_SECONDS=120

# Optional Worker admission thresholds (0 disables).
RELAY_WORKER_MIN_SPEED_BPS=0
RELAY_WORKER_MAX_LATENCY_MS=0

# n8n automation API (token-protected /api/automation/*). Empty disables it.
RELAY_AUTOMATION_TOKEN=
RELAY_AUTOMATION_MIN_FREE_GB=8
RELAY_AUTOMATION_MAX_BATCH=3
RELAY_AUTOMATION_TARGET_DEPTH=2
# A catalogue pass (new series/episodes) may start this often, at most.
RELAY_AUTOMATION_CATALOGUE_HOURS=6
RELAY_AUTOMATION_CATALOGUE_SLEEP=250

# Largest file the relay accepts, in MB. Keep at or below nginx
# client_max_body_size (2048m in the image).
RELAY_MAX_UPLOAD_MB=2048

# ── Telegram bot (Flixy) ────────────────────────────────────────────────────
# Everything is off by default: with RELAY_BOT_ENABLED=false the webhook answers
# 404 and no token is used. The panel's Bot card stores the same values in
# global_settings, and a value saved there wins over the one in this file.
RELAY_BOT_ENABLED=false
# BotFather token. Treat it as a secret: rotate it in the panel, never commit it.
RELAY_BOT_TOKEN=
# Telegram's X-Telegram-Bot-Api-Secret-Token; it is also the webhook URL path.
RELAY_BOT_WEBHOOK_SECRET=
# Allowed Telegram user ids, comma/space separated (ids, not usernames).
RELAY_BOT_ALLOWED_IDS=
# Destination chat the bot copies documents into (zero bytes transferred).
RELAY_BOT_STORAGE_CHAT=
# Telegram Drive channel-registry id for the manifest fallback (0 = unused).
RELAY_BOT_CHANNEL_ID=0
# Quality stored on submissions that are not a series.
RELAY_BOT_QUALITY=1080
# Files one allowed user may send per day (0 = unlimited).
RELAY_BOT_DAILY_LIMIT=20
# Per-file ceiling in MB (0 = none): a daily count does not bound disk use.
RELAY_BOT_MAX_SIZE_MB=2048
# copyMessage is a server-side copy, so this is seconds, not minutes.
RELAY_BOT_COPY_TIMEOUT=60
# Webhook reply budget in seconds; must stay inside Telegram's delivery window.
RELAY_BOT_REPLY_TIMEOUT=5
# Bot imports get their own supervised lane so a large import never waits behind
# a panel download. The import job and the supervisor both read this name.
RELAY_BOT_QUEUE=bot
# Workers on that lane; the relay queue supervisor clamps it to 1..2.
RELAY_BOT_CONCURRENCY=1
# A submission left untouched this long is re-queued, at most every
# RELAY_BOT_REQUEUE_SECONDS, so no row stays stuck at "queued".
RELAY_BOT_STALE_SECONDS=600
RELAY_BOT_REQUEUE_SECONDS=300
# Dedup rows older than this are pruned (never below 1 day, which keeps
# Telegram's 24-hour retry window covered) at most every prune interval
# (0 = never prune).
RELAY_BOT_UPDATE_RETENTION_DAYS=2
RELAY_BOT_PRUNE_SECONDS=3600
