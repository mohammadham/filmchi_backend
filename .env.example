APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=7200

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Media relay: Telegram Drive (primary storage) + 9drive (cache tier)
# ---------------------------------------------------------------------------
# Public links are served on this site's own domain; no file is ever written
# to this server (uploads and downloads are streamed through).
RELAY_ENABLED=true

# Telegram Drive service (FastAPI "TelegramDrive")
TGDRIVE_BASE_URL=
TGDRIVE_USERNAME=admin
TGDRIVE_PASSWORD=
TGDRIVE_API_KEY=
TGDRIVE_STORAGE_CHAT=
TGDRIVE_DEFAULT_BACKEND=telegram

# 9drive (Google Drive gateway) — the API key needs the files:upload scope
NINEDRIVE_BASE_URL=
NINEDRIVE_API_KEY=
NINEDRIVE_EMAIL=
NINEDRIVE_PASSWORD=
NINEDRIVE_FOLDER_ID=
NINEDRIVE_FRONTEND_URL=
NINEDRIVE_SERVE_MODE=auto

# Relay link behaviour
RELAY_LINK_TTL=0
RELAY_PROXY_STREAM=true
RELAY_CHUNK_SIZE=262144
# Seconds a download may go without a byte before the job gives up (per read).
RELAY_INGEST_STALL_TIMEOUT=300

# Fixed-size ranged chunk for the dynamic ingest queue (MB).
# 8MB keeps each request tiny; a fast worker picks up many chunks,
# a slow/retrying worker only repeats a few MB instead of hundreds.
RELAY_INGEST_CHUNK_MB=8
RELAY_INGEST_CHUNK_STALL_TIMEOUT=60
RELAY_INGEST_CONNECTIONS=24
RELAY_WORKER_STREAMS=2

# Demand tracking / promotion policy
# Set CACHE_DRIVER=redis (or RELAY_STATE_STORE=redis) to keep counters in Redis.
RELAY_STATE_STORE=
RELAY_PROMOTE_THRESHOLD=3
RELAY_DEMAND_WINDOW=86400
RELAY_CACHE_TTL=0
RELAY_AUTO_PROMOTE=true
RELAY_QUEUE_NAME=default

# Optional Worker admission thresholds (0 disables).
RELAY_WORKER_MIN_SPEED_BPS=0
RELAY_WORKER_MAX_LATENCY_MS=0

# n8n automation API (token-protected /api/automation/*). Empty disables it.
RELAY_AUTOMATION_TOKEN=
RELAY_AUTOMATION_MIN_FREE_GB=8
RELAY_AUTOMATION_MAX_BATCH=3
RELAY_AUTOMATION_TARGET_DEPTH=2
# A catalogue pass (new series/episodes) may start this often, at most.
RELAY_AUTOMATION_CATALOGUE_HOURS=6
RELAY_AUTOMATION_CATALOGUE_SLEEP=250
