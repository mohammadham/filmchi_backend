APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Media relay: Telegram Drive (primary storage) + 9drive (cache tier)
# ---------------------------------------------------------------------------
# Public links are served on this site's own domain; no file is ever written
# to this server (uploads and downloads are streamed through).
RELAY_ENABLED=true

# Telegram Drive service (FastAPI "TelegramDrive")
TGDRIVE_BASE_URL=
TGDRIVE_USERNAME=admin
TGDRIVE_PASSWORD=
TGDRIVE_API_KEY=
TGDRIVE_STORAGE_CHAT=
TGDRIVE_DEFAULT_BACKEND=telegram

# 9drive (Google Drive gateway) — the API key needs the files:upload scope
NINEDRIVE_BASE_URL=
NINEDRIVE_API_KEY=
NINEDRIVE_EMAIL=
NINEDRIVE_PASSWORD=
NINEDRIVE_FOLDER_ID=
NINEDRIVE_FRONTEND_URL=
NINEDRIVE_SERVE_MODE=auto

# Relay link behaviour
RELAY_LINK_TTL=0
RELAY_PROXY_STREAM=true
RELAY_CHUNK_SIZE=262144

# Demand tracking / promotion policy
# Set CACHE_DRIVER=redis (or RELAY_STATE_STORE=redis) to keep counters in Redis.
RELAY_STATE_STORE=
RELAY_PROMOTE_THRESHOLD=3
RELAY_DEMAND_WINDOW=86400
RELAY_CACHE_TTL=0
RELAY_AUTO_PROMOTE=true
RELAY_QUEUE_NAME=default
